{
  "Extraction": {
    "Csv": {
      "FilePath": "Data/encuestas.csv"
    },
    "Database": {
      "Query": "SELECT Id, CustomerName, Rating, Comment, CreatedAt FROM dbo.Reviews"
    },
    "Api": {
      "BaseUrl": "https://jsonplaceholder.typicode.com/",
      "Endpoint": "comments"
    }
  },
  "Staging": {
    "OutputDirectory": "staging"
  },
  "Worker": {
    "RunIntervalMinutes": 1440
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft": "Warning"
    }
  }
}
